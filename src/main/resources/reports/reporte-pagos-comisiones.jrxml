<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_pagos_comisiones" language="java" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1f23456-7890-4cde-fa12-34567890bcde">

    <!-- Parameters -->
    <parameter name="P_START_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_END_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PROMOTER_ID" class="java.lang.Long">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PAYOUT_REFERENCE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_COMPANY_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_REPORT_FOOTER" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TARGET_CURRENCY" class="java.lang.String">
        <defaultValueExpression><![CDATA["USD"]]></defaultValueExpression>
    </parameter>

    <!-- Query -->
    <queryString>
        <![CDATA[
        SELECT
            c.commissions_id,
            c.uuid AS commission_uuid,
            c.status AS status,
            CASE 
                WHEN c.status = 'DISPUTED' THEN 'En disputa'
                WHEN c.status = 'PAID' THEN 'Pagada'
                ELSE c.status 
            END AS status_label,
            c.applies_to,
            CASE 
                WHEN c.applies_to = 'INSCRIPTION' THEN 'Inscripción'
                WHEN c.applies_to = 'MONTHLY' THEN 'Mensualidad'
                ELSE c.applies_to
            END AS applies_to_label,
            c.period_start,
            c.period_end,
            c.earned_at,
            c.amount AS amount,
            cur.code AS currency,
            COALESCE(conv.target_currency_code, UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))) AS target_currency_code,
            COALESCE(conv.target_currency_symbol, '$') AS target_currency_symbol,
            conv.converted_amount AS converted_amount,
            conv.exchange_rate AS exchange_rate,
            c.calculation_basis,
            c.commission_pct,
            c.flat_amount,
            COALESCE(c.tier_name_snapshot, 'Base estándar') AS tier_name,
            COALESCE(payout_lines.reference_number, c.payout_reference, '-') AS payout_reference,
            COALESCE(payout_p.payment_date, c.paid_at::date) AS payout_date,
            COALESCE(payout_lines.payout_method_label, 'Transferencia') AS payout_method_label,
            COALESCE(payout_lines.payout_bank_name, '-') AS payout_bank_name,
            c.paid_at,
            pr.promoters_id,
            pr.display_name AS promoter_name,
            pr.referral_code AS promoter_code,
            COALESCE(pr_p.full_name, pr.display_name) AS promoter_person_name,
            COALESCE(pr_p.document_type || '-' || pr_p.document_number, 'N/A') AS promoter_document,
            COALESCE(pr.phone, pr_p.phone, 'N/A') AS promoter_phone,
            COALESCE(pr.email::text, pr_p.email::text, 'N/A') AS promoter_email,
            COALESCE(pt.name, 'Estándar') AS promoter_type,
            m_p.full_name AS member_name,
            (m_p.document_type || '-' || m_p.document_number) AS member_document,
            p.payment_date,
            pline.payment_reference AS payment_reference,
            p.amount AS payment_amount,
            pl.name AS plan_name
        FROM app.commissions c
        JOIN app.currencies cur ON c.currency_id = cur.currencies_id
        JOIN app.promoters pr ON c.promoter_id = pr.promoters_id
        LEFT JOIN app.persons pr_p ON pr.person_id = pr_p.persons_id
        LEFT JOIN app.promoter_types pt ON pr.promoter_type_id = pt.promoter_types_id
        JOIN app.members m ON c.member_id = m.members_id
        JOIN app.persons m_p ON m.person_id = m_p.persons_id
        JOIN app.payments p ON c.payment_id = p.payments_id
        LEFT JOIN LATERAL (
            SELECT STRING_AGG(DISTINCT pl.reference_number, ', ') AS payment_reference
            FROM app.payment_lines pl
            WHERE pl.payment_id = p.payments_id
        ) pline ON true
        LEFT JOIN app.memberships ms ON p.membership_id = ms.memberships_id
        LEFT JOIN app.plans pl ON ms.plan_id = pl.plans_id
        LEFT JOIN app.payments payout_p ON payout_p.payments_id = c.payout_payment_id
        LEFT JOIN LATERAL (
            SELECT
                STRING_AGG(DISTINCT pol.reference_number, ', ') AS reference_number,
                STRING_AGG(DISTINCT COALESCE(popm.name, popm.code), ', ') AS payout_method_label,
                STRING_AGG(DISTINCT pob.short_name, ', ') AS payout_bank_name
            FROM app.payment_lines pol
            LEFT JOIN app.payment_methods popm ON popm.payment_methods_id = pol.payment_type_id
            LEFT JOIN app.banks pob ON pob.banks_id = pol.bank_id
            WHERE pol.payment_id = payout_p.payments_id
        ) payout_lines ON true
        LEFT JOIN LATERAL (
            SELECT
                tc.currencies_id AS target_currency_id,
                tc.code AS target_currency_code,
                tc.symbol AS target_currency_symbol,
                CASE
                    WHEN c.currency_id = tc.currencies_id THEN 1.0
                    WHEN direct.rate IS NOT NULL THEN direct.rate
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(1.0 / inv.rate, 8)
                    ELSE NULL
                END AS exchange_rate,
                CASE
                    WHEN c.currency_id = tc.currencies_id THEN c.amount
                    WHEN direct.rate IS NOT NULL THEN ROUND(c.amount * direct.rate, tc.decimal_places)
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(c.amount / inv.rate, tc.decimal_places)
                    ELSE NULL
                END AS converted_amount
            FROM app.currencies tc
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = c.currency_id
                  AND er.quote_currency_id = tc.currencies_id
                  AND er.valid_from <= ((COALESCE(payout_p.payment_date, c.paid_at::date, c.earned_at::date, CURRENT_DATE) + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) direct ON true
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = tc.currencies_id
                  AND er.quote_currency_id = c.currency_id
                  AND er.valid_from <= ((COALESCE(payout_p.payment_date, c.paid_at::date, c.earned_at::date, CURRENT_DATE) + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) inv ON true
            WHERE tc.code = UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))
            LIMIT 1
        ) conv ON true
        WHERE c.is_active = true
          AND (c.status = 'PAID' OR c.paid_at IS NOT NULL OR c.payout_payment_id IS NOT NULL)
          AND ($P{P_START_DATE}::date IS NULL OR COALESCE(payout_p.payment_date, c.paid_at::date) >= $P{P_START_DATE}::date)
          AND ($P{P_END_DATE}::date IS NULL OR COALESCE(payout_p.payment_date, c.paid_at::date) <= $P{P_END_DATE}::date)
          AND ($P{P_PROMOTER_ID}::bigint IS NULL OR c.promoter_id = $P{P_PROMOTER_ID}::bigint)
          AND ($P{P_PAYOUT_REFERENCE}::varchar IS NULL OR $P{P_PAYOUT_REFERENCE} = '' OR c.payout_reference ILIKE '%' || $P{P_PAYOUT_REFERENCE} || '%' OR payout_lines.reference_number ILIKE '%' || $P{P_PAYOUT_REFERENCE} || '%')
        ORDER BY 
            pr.display_name ASC,
            COALESCE(payout_p.payment_date, c.paid_at::date) DESC,
            payout_reference ASC
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="commissions_id" class="java.lang.Long"/>
    <field name="status" class="java.lang.String"/>
    <field name="status_label" class="java.lang.String"/>
    <field name="applies_to" class="java.lang.String"/>
    <field name="applies_to_label" class="java.lang.String"/>
    <field name="period_start" class="java.sql.Date"/>
    <field name="period_end" class="java.sql.Date"/>
    <field name="earned_at" class="java.sql.Timestamp"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="converted_amount" class="java.math.BigDecimal"/>
    <field name="target_currency_code" class="java.lang.String"/>
    <field name="target_currency_symbol" class="java.lang.String"/>
    <field name="exchange_rate" class="java.math.BigDecimal"/>
    <field name="calculation_basis" class="java.math.BigDecimal"/>
    <field name="commission_pct" class="java.math.BigDecimal"/>
    <field name="flat_amount" class="java.math.BigDecimal"/>
    <field name="tier_name" class="java.lang.String"/>
    <field name="payout_reference" class="java.lang.String"/>
    <field name="payout_date" class="java.sql.Date"/>
    <field name="payout_method_label" class="java.lang.String"/>
    <field name="payout_bank_name" class="java.lang.String"/>
    <field name="paid_at" class="java.sql.Timestamp"/>
    <field name="promoters_id" class="java.lang.Long"/>
    <field name="promoter_name" class="java.lang.String"/>
    <field name="promoter_code" class="java.lang.String"/>
    <field name="promoter_person_name" class="java.lang.String"/>
    <field name="promoter_document" class="java.lang.String"/>
    <field name="promoter_phone" class="java.lang.String"/>
    <field name="promoter_email" class="java.lang.String"/>
    <field name="promoter_type" class="java.lang.String"/>
    <field name="member_name" class="java.lang.String"/>
    <field name="member_document" class="java.lang.String"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="payment_reference" class="java.lang.String"/>
    <field name="payment_amount" class="java.math.BigDecimal"/>
    <field name="plan_name" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="V_PROMOTER_TOTAL" class="java.math.BigDecimal" resetType="Group" resetGroup="PromoterGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>
    <variable name="V_PROMOTER_CONVERTED_TOTAL" class="java.math.BigDecimal" resetType="Group" resetGroup="PromoterGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_amount}]]></variableExpression>
    </variable>
    <variable name="V_PROMOTER_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="PromoterGroup" calculation="Count">
        <variableExpression><![CDATA[$F{commissions_id}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_CONVERTED_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{commissions_id}]]></variableExpression>
    </variable>

    <!-- Group by Promoter -->
    <group name="PromoterGroup">
        <groupExpression><![CDATA[$F{promoters_id}]]></groupExpression>
        <groupHeader>
            <band height="44">
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="4" width="555" height="22" backcolor="#F0F4F8" forecolor="#D0D7DE"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="8" y="6" width="260" height="16" forecolor="#0F172A"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Promotor: " + $F{promoter_name} + " (" + $F{promoter_code} + ")"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="270" y="8" width="140" height="14"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="8" isBold="false"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Doc: " + $F{promoter_document}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="420" y="8" width="130" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="8" isBold="false"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Tipo: " + $F{promoter_type}]]></textFieldExpression>
                </textField>

                <!-- Column Headers for Details -->
                <staticText>
                    <reportElement mode="Opaque" x="0" y="28" width="50" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Fecha Pago]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="50" y="28" width="70" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Ref. Liq.]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="120" y="28" width="105" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Afiliado / Cédula]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="225" y="28" width="80" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Concepto / Plan]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="305" y="28" width="45" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <text><![CDATA[Base ($)]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="350" y="28" width="40" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Tasa/Fijo]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="390" y="28" width="35" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Moneda]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="425" y="28" width="55" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <text><![CDATA[Monto Orig.]]></text>
                </staticText>
                <textField>
                    <reportElement mode="Opaque" x="480" y="28" width="75" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA["Conv. (" + ($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="1" width="555" height="16" backcolor="#F8FAFC" forecolor="#E2E8F0"/>
                </rectangle>
                <textField>
                    <reportElement x="6" y="2" width="230" height="14"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Subtotal pagado a " + $F{promoter_name} + " (" + $V{V_PROMOTER_COUNT} + " pagos):"]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement x="240" y="2" width="170" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="7" isBold="false"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Orig: " + new java.text.DecimalFormat("#,##0.00").format($V{V_PROMOTER_TOTAL})]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="415" y="2" width="135" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="8" isBold="true"/>
                        <paragraph rightIndent="4"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$V{V_PROMOTER_CONVERTED_TOTAL} != null ? (($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + " " + new java.text.DecimalFormat("#,##0.00").format($V{V_PROMOTER_CONVERTED_TOTAL})) : "-"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <!-- Title -->
    <title>
        <band height="72">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="46" backcolor="#0F172A"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="13" width="360" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE PAGOS DE COMISIONES]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="380" y="16" width="165" height="14" forecolor="#94A3B8"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- Filter Badges -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="48" width="555" height="18" backcolor="#F1F5F9" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="6" y="50" width="540" height="14"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isItalic="true" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros: [Fecha pago: " + ($P{P_START_DATE} != null ? $P{P_START_DATE} : "Inicio") + " al " + ($P{P_END_DATE} != null ? $P{P_END_DATE} : "Hoy") + "] | [Moneda destino: " + ($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + " (Tasa a fecha de pago)] | [Ref: " + ($P{P_PAYOUT_REFERENCE} != null && !$P{P_PAYOUT_REFERENCE}.isEmpty() ? $P{P_PAYOUT_REFERENCE} : "TODAS") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail Band -->
    <detail>
        <band height="16">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="50" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{payout_date} != null ? $F{payout_date} : ($F{paid_at} != null ? new java.sql.Date($F{paid_at}.getTime()) : null)]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="70" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{payout_reference} + ("-".equals($F{payout_bank_name}) ? "" : " (" + $F{payout_bank_name} + ")")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="105" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{member_name} + " (" + $F{member_document} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="225" y="0" width="80" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{applies_to_label} + " - " + $F{plan_name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="305" y="0" width="45" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{calculation_basis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="0" width="40" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{commission_pct} != null ? ($F{commission_pct} + "%") : ("$" + $F{flat_amount})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="390" y="0" width="35" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{currency}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="425" y="0" width="55" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="480" y="0" width="75" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                    <paragraph rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{converted_amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="300" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_REPORT_FOOTER} != null ? $P{P_REPORT_FOOTER} : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="2" width="160" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="515" y="2" width="40" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary -->
    <summary>
        <band height="40">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="8" width="555" height="26" backcolor="#0F172A" forecolor="#0F172A"/>
            </rectangle>
            <staticText>
                <reportElement x="12" y="13" width="260" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL GENERAL DESEMBOLSADO CONVERTIDO:]]></text>
            </staticText>
            <textField>
                <reportElement x="275" y="13" width="110" height="16" forecolor="#94A3B8"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{V_GRAND_COUNT} + " pagos a promotores"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="12" width="160" height="18" forecolor="#38BDF8"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                    <paragraph rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{V_GRAND_CONVERTED_TOTAL} != null ? (($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + " " + new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_CONVERTED_TOTAL})) : "-"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
