<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_pagos" language="java" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b5f23456-7890-5cde-fa12-34567890bcde">

    <!-- Parameters -->
    <parameter name="P_START_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_END_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_STATUS" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PAYMENT_METHOD" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PLAN_ID" class="java.lang.Long">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PROMOTER_ID" class="java.lang.Long">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_COMPANY_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_REPORT_FOOTER" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TARGET_CURRENCY" class="java.lang.String">
        <defaultValueExpression><![CDATA["USD"]]></defaultValueExpression>
    </parameter>

    <!-- Query -->
    <queryString>
        <![CDATA[
        SELECT
            p.payments_id,
            p.uuid AS payment_uuid,
            p.payment_date,
            p.received_at,
            p.payment_method,
            CASE 
                WHEN p.payment_method = 'CASH' THEN 'Efectivo'
                WHEN p.payment_method = 'PAGO_MOVIL' THEN 'Pago Móvil'
                WHEN p.payment_method = 'ZELLE' THEN 'Zelle'
                WHEN p.payment_method = 'BANK_TRANSFER' THEN 'Transferencia Bancaria'
                WHEN p.payment_method = 'INTERNATIONAL_TRANSFER' THEN 'Transferencia Internacional'
                WHEN p.payment_method = 'CRYPTO' THEN 'Cripto'
                WHEN p.payment_method = 'OTHER' THEN 'Otro'
                ELSE p.payment_method 
            END AS payment_method_label,
            COALESCE(p.reference_number, 'S/R') AS reference_number,
            p.status AS payment_status,
            CASE 
                WHEN p.status = 'APPROVED' THEN 'Aprobado'
                WHEN p.status = 'PENDING' THEN 'Pendiente'
                WHEN p.status = 'REJECTED' THEN 'Rechazado'
                ELSE p.status 
            END AS payment_status_label,
            p.inscription,
            CASE 
                WHEN p.inscription THEN 'Inscripción' 
                ELSE 'Mensualidad' 
            END AS concept_label,
            p.applied_period,
            p.amount AS gross_amount,
            cur.code AS currency,
            COALESCE(p.discount_amount, 0.00) AS discount_amount,
            (p.amount - COALESCE(p.discount_amount, 0.00)) AS net_amount,
            COALESCE(conv.target_currency_code, UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))) AS target_currency_code,
            COALESCE(conv.target_currency_symbol, '$') AS target_currency_symbol,
            conv.converted_gross_amount,
            conv.converted_discount_amount,
            conv.converted_net_amount,
            conv.exchange_rate,
            COALESCE(p.admin_notes, '-') AS admin_notes,
            p.reviewed_at,
            COALESCE(p.review_reason, '-') AS review_reason,
            COALESCE(ru_p.full_name, 'Sin Revisar') AS reviewer_name,
            pl.plans_id,
            pl.code AS plan_code,
            pl.name AS plan_name,
            pl.type AS plan_type,
            m.members_id,
            m.uuid AS member_uuid,
            m_p.full_name AS member_name,
            (m_p.document_type || '-' || m_p.document_number) AS member_document,
            COALESCE(m_p.phone, 'N/A') AS member_phone,
            COALESCE(m_p.email::text, 'N/A') AS member_email,
            COALESCE(pr.display_name, 'Directo / Sin Promotor') AS promoter_name,
            COALESCE(pr.referral_code, '-') AS promoter_referral_code
        FROM app.payments p
        JOIN app.currencies cur ON p.currency_id = cur.currencies_id
        JOIN app.memberships ms ON p.membership_id = ms.memberships_id
        JOIN app.plans pl ON ms.plan_id = pl.plans_id
        JOIN app.members m ON ms.member_id = m.members_id
        JOIN app.persons m_p ON m.person_id = m_p.persons_id
        LEFT JOIN app.promoters pr ON m.promoter_id = pr.promoters_id
        LEFT JOIN app.users ru ON p.reviewed_by = ru.users_id
        LEFT JOIN app.persons ru_p ON ru.person_id = ru_p.persons_id
        LEFT JOIN LATERAL (
            SELECT
                tc.currencies_id AS target_currency_id,
                tc.code AS target_currency_code,
                tc.symbol AS target_currency_symbol,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN 1.0
                    WHEN direct.rate IS NOT NULL THEN direct.rate
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(1.0 / inv.rate, 8)
                    ELSE NULL
                END AS exchange_rate,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN p.amount
                    WHEN direct.rate IS NOT NULL THEN ROUND(p.amount * direct.rate, tc.decimal_places)
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(p.amount / inv.rate, tc.decimal_places)
                    ELSE NULL
                END AS converted_gross_amount,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN COALESCE(p.discount_amount, 0.00)
                    WHEN direct.rate IS NOT NULL THEN ROUND(COALESCE(p.discount_amount, 0.00) * direct.rate, tc.decimal_places)
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(COALESCE(p.discount_amount, 0.00) / inv.rate, tc.decimal_places)
                    ELSE NULL
                END AS converted_discount_amount,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN (p.amount - COALESCE(p.discount_amount, 0.00))
                    WHEN direct.rate IS NOT NULL THEN ROUND((p.amount - COALESCE(p.discount_amount, 0.00)) * direct.rate, tc.decimal_places)
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND((p.amount - COALESCE(p.discount_amount, 0.00)) / inv.rate, tc.decimal_places)
                    ELSE NULL
                END AS converted_net_amount
            FROM app.currencies tc
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = p.currency_id
                  AND er.quote_currency_id = tc.currencies_id
                  AND er.valid_from <= ((p.payment_date + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) direct ON true
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = tc.currencies_id
                  AND er.quote_currency_id = p.currency_id
                  AND er.valid_from <= ((p.payment_date + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) inv ON true
            WHERE tc.code = UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))
            LIMIT 1
        ) conv ON true
        WHERE p.is_active = true
          AND ($P{P_START_DATE}::date IS NULL OR p.payment_date >= $P{P_START_DATE}::date)
          AND ($P{P_END_DATE}::date IS NULL OR p.payment_date <= $P{P_END_DATE}::date)
          AND ($P{P_STATUS}::varchar IS NULL OR $P{P_STATUS} = '' OR p.status = $P{P_STATUS}::varchar)
          AND ($P{P_PAYMENT_METHOD}::varchar IS NULL OR $P{P_PAYMENT_METHOD} = '' OR p.payment_method = $P{P_PAYMENT_METHOD}::varchar)
          AND ($P{P_PLAN_ID}::bigint IS NULL OR pl.plans_id = $P{P_PLAN_ID}::bigint)
          AND ($P{P_PROMOTER_ID}::bigint IS NULL OR pr.promoters_id = $P{P_PROMOTER_ID}::bigint)
        ORDER BY 
            p.payment_method ASC,
            p.payment_date DESC,
            p.payments_id DESC
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="payments_id" class="java.lang.Long"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="payment_method_label" class="java.lang.String"/>
    <field name="reference_number" class="java.lang.String"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="payment_status_label" class="java.lang.String"/>
    <field name="concept_label" class="java.lang.String"/>
    <field name="applied_period" class="java.sql.Date"/>
    <field name="gross_amount" class="java.math.BigDecimal"/>
    <field name="discount_amount" class="java.math.BigDecimal"/>
    <field name="net_amount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="target_currency_code" class="java.lang.String"/>
    <field name="target_currency_symbol" class="java.lang.String"/>
    <field name="converted_gross_amount" class="java.math.BigDecimal"/>
    <field name="converted_discount_amount" class="java.math.BigDecimal"/>
    <field name="converted_net_amount" class="java.math.BigDecimal"/>
    <field name="exchange_rate" class="java.math.BigDecimal"/>
    <field name="reviewer_name" class="java.lang.String"/>
    <field name="plan_name" class="java.lang.String"/>
    <field name="member_name" class="java.lang.String"/>
    <field name="member_document" class="java.lang.String"/>
    <field name="member_phone" class="java.lang.String"/>
    <field name="promoter_name" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="V_METHOD_GROSS" class="java.math.BigDecimal" resetType="Group" resetGroup="MethodGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{gross_amount}]]></variableExpression>
    </variable>
    <variable name="V_METHOD_DISCOUNT" class="java.math.BigDecimal" resetType="Group" resetGroup="MethodGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{discount_amount}]]></variableExpression>
    </variable>
    <variable name="V_METHOD_NET" class="java.math.BigDecimal" resetType="Group" resetGroup="MethodGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{net_amount}]]></variableExpression>
    </variable>
    <variable name="V_METHOD_CONVERTED_NET" class="java.math.BigDecimal" resetType="Group" resetGroup="MethodGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_net_amount}]]></variableExpression>
    </variable>
    <variable name="V_METHOD_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="MethodGroup" calculation="Count">
        <variableExpression><![CDATA[$F{payments_id}]]></variableExpression>
    </variable>

    <variable name="V_GRAND_GROSS" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{gross_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_DISCOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{discount_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_NET" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{net_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_CONVERTED_NET" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_net_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{payments_id}]]></variableExpression>
    </variable>

    <!-- Group by Payment Method -->
    <group name="MethodGroup">
        <groupExpression><![CDATA[$F{payment_method}]]></groupExpression>
        <groupHeader>
            <band height="42">
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="4" width="802" height="20" backcolor="#F0F4F8" forecolor="#CBD5E1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="8" y="7" width="400" height="14"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["MÉTODO DE PAGO: " + $F{payment_method_label}]]></textFieldExpression>
                </textField>

                <!-- Column Headers -->
                <staticText>
                    <reportElement mode="Opaque" x="0" y="26" width="50" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Fecha]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="50" y="26" width="70" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Referencia]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="120" y="26" width="145" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Afiliado / Cédula]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="265" y="26" width="80" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph leftIndent="4"/></textElement>
                    <text><![CDATA[Plan]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="345" y="26" width="60" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Concepto]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="405" y="26" width="37" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Moneda]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="442" y="26" width="55" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <text><![CDATA[Monto Bruto]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="497" y="26" width="45" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <text><![CDATA[Descuento]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="542" y="26" width="55" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <text><![CDATA[Neto Orig.]]></text>
                </staticText>
                <textField>
                    <reportElement mode="Opaque" x="597" y="26" width="68" height="15" backcolor="#E2E8F0"/>
                    <box><pen lineWidth="0.25" lineColor="#CBD5E1"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA["Conv. (" + ($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + ")"]]></textFieldExpression>
