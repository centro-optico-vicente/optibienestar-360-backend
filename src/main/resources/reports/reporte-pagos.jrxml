                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Subtotal " + $F{payment_method_label} + " (" + $V{V_METHOD_COUNT} + " pagos):"]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement x="442" y="3" width="55" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA[$V{V_METHOD_GROSS}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement x="497" y="3" width="45" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA[$V{V_METHOD_DISCOUNT}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement x="542" y="3" width="55" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA[$V{V_METHOD_NET}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="597" y="3" width="68" height="14"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph rightIndent="4"/></textElement>
                    <textFieldExpression><![CDATA[$V{V_METHOD_CONVERTED_NET} != null ? new java.text.DecimalFormat("#,##0.00").format($V{V_METHOD_CONVERTED_NET}) : "-"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <!-- Title -->
    <title>
        <band height="68">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="44" backcolor="#0F172A"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="12" width="500" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE PAGOS DE AFILIADOS Y RECAUDACIÓN]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="550" y="15" width="240" height="14" forecolor="#94A3B8"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- Filters Summary -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="46" width="802" height="18" backcolor="#F1F5F9" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="8" y="48" width="785" height="14"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros: [Fechas: " + ($P{P_START_DATE} != null ? $P{P_START_DATE} : "Inicio") + " al " + ($P{P_END_DATE} != null ? $P{P_END_DATE} : "Hoy") + "] | [Moneda: " + ($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + "] | [Estatus: " + ($P{P_STATUS} != null && !$P{P_STATUS}.isEmpty() ? $P{P_STATUS} : "TODOS") + "] | [Método: " + ($P{P_PAYMENT_METHOD} != null && !$P{P_PAYMENT_METHOD}.isEmpty() ? $P{P_PAYMENT_METHOD} : "TODOS") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail Band -->
    <detail>
        <band height="16">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="50" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{payment_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="70" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{reference_number}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="145" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{member_name} + " (" + $F{member_document} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="265" y="0" width="80" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{plan_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="345" y="0" width="60" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{concept_label}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="0" width="37" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{currency}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="442" y="0" width="55" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{gross_amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="497" y="0" width="45" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{discount_amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="542" y="0" width="55" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{net_amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="597" y="0" width="68" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{converted_net_amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="665" y="0" width="50" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{payment_status_label}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="715" y="0" width="87" height="15"/>
                <box><bottomPen lineWidth="0.25" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{promoter_name}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="500" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_REPORT_FOOTER} != null ? $P{P_REPORT_FOOTER} : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="2" width="160" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="760" y="2" width="40" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Band -->
    <summary>
        <band height="36">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="6" width="802" height="24" backcolor="#0F172A" forecolor="#0F172A"/>
            </rectangle>
            <textField>
                <reportElement x="12" y="10" width="280" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL RECAUDACIÓN (" + $V{V_GRAND_COUNT} + " Pagos):"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="295" y="10" width="115" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Bruto Orig: " + new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_GROSS})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="415" y="10" width="95" height="16" forecolor="#F87171"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Desc: " + new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_DISCOUNT})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="515" y="10" width="105" height="16" forecolor="#CBD5E1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Neto Orig: " + new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_NET})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="625" y="10" width="167" height="16" forecolor="#38BDF8"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/><paragraph rightIndent="8"/></textElement>
                <textFieldExpression><![CDATA[$V{V_GRAND_CONVERTED_NET} != null ? ("Total Conv: " + ($P{P_TARGET_CURRENCY} != null ? $P{P_TARGET_CURRENCY} : "USD") + " " + new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_CONVERTED_NET})) : "Total Conv: -"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
