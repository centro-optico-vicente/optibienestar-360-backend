                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="750" y="2" width="50" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Grand Totals -->
    <summary>
        <band height="30">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="4" width="802" height="22" backcolor="#0F172A" forecolor="#0F172A"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="8" y="7" width="550" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["TOTAL GENERAL DE MOVIMIENTOS (" + $V{V_GRAND_COUNT} + " registros):"]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="560" y="7" width="65" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                    <paragraph rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{V_GRAND_NET}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="625" y="7" width="80" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                    <paragraph rightIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{V_GRAND_CONVERTED_NET} != null ? new java.text.DecimalFormat("#,##0.00").format($V{V_GRAND_CONVERTED_NET}) : "-"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
