<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_movimientos_pagos" language="java" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c6f34567-8901-4def-fa23-45678901cdef">

    <!-- Parameters -->
    <parameter name="P_START_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_END_DATE" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_DIRECTION" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_STATUS" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PAYMENT_METHOD" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="P_COMPANY_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_REPORT_FOOTER" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TARGET_CURRENCY" class="java.lang.String">
        <defaultValueExpression><![CDATA["USD"]]></defaultValueExpression>
    </parameter>

    <!-- Query -->
    <queryString>
        <![CDATA[
        SELECT
            p.payments_id,
            p.uuid AS payment_uuid,
            p.direction,
            CASE
                WHEN p.direction = 'IN' THEN 'Cobro (Ingreso)'
                WHEN p.direction = 'OUT' THEN 'Pago (Egreso / Liquidación)'
                ELSE p.direction
            END AS direction_label,
            p.payment_date,
            p.received_at,
            pm.code AS payment_method,
            COALESCE(pm.name, pm.code) || CASE WHEN b.short_name IS NOT NULL THEN ' - ' || b.short_name ELSE '' END AS payment_method_label,
            COALESCE(pline.reference_number, 'S/R') AS reference_number,
            p.status AS payment_status,
            CASE
                WHEN p.status = 'APPROVED' THEN 'Aprobado'
                WHEN p.status = 'PENDING' THEN 'Pendiente'
                WHEN p.status = 'REJECTED' THEN 'Rechazado'
                ELSE p.status
            END AS payment_status_label,
            pc.code AS category_code,
            COALESCE(pc.name, CASE WHEN p.inscription THEN 'Inscripción' ELSE 'Mensualidad' END) AS category_name,
            COALESCE(pline.amount, p.amount) AS gross_amount,
            cur.code AS currency,
            CASE 
                WHEN p.amount > 0 AND p.discount_amount IS NOT NULL 
                THEN ROUND(p.discount_amount * (COALESCE(pline.amount, p.amount) / p.amount), 2)
                ELSE 0.00 
            END AS discount_amount,
            COALESCE(pline.amount, p.amount) - (
                CASE 
                    WHEN p.amount > 0 AND p.discount_amount IS NOT NULL 
                    THEN ROUND(p.discount_amount * (COALESCE(pline.amount, p.amount) / p.amount), 2)
                    ELSE 0.00 
                END
            ) AS net_amount,
            COALESCE(conv.target_currency_code, UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))) AS target_currency_code,
            COALESCE(conv.target_currency_symbol, '$') AS target_currency_symbol,
            conv.converted_amount,
            conv.exchange_rate,
            COALESCE(p.admin_notes, '-') AS admin_notes,
            p.reviewed_at,
            COALESCE(p.review_reason, '-') AS review_reason,
            COALESCE(ru_p.full_name, 'Sin Revisar') AS reviewer_name,
            per.persons_id,
            per.full_name AS person_name,
            (per.document_type || '-' || per.document_number) AS person_document,
            COALESCE(pr.display_name, 'Directo / Sin Promotor') AS promoter_name,
            COALESCE(pr.referral_code, '-') AS promoter_referral_code,
            pl.name AS plan_name
        FROM app.payments p
        JOIN app.currencies cur ON p.currency_id = cur.currencies_id
        JOIN app.payment_categories pc ON p.payment_type_id = pc.payment_categories_id
        LEFT JOIN app.payment_lines pline ON pline.payment_id = p.payments_id
        LEFT JOIN app.payment_methods pm ON pm.payment_methods_id = pline.payment_type_id
        LEFT JOIN app.banks b ON b.banks_id = pline.bank_id
        LEFT JOIN app.persons per ON p.person_id = per.persons_id
        LEFT JOIN app.promoters pr ON p.promoter_id = pr.promoters_id
        LEFT JOIN app.memberships ms ON p.membership_id = ms.memberships_id
        LEFT JOIN app.plans pl ON ms.plan_id = pl.plans_id
        LEFT JOIN app.users ru ON p.reviewed_by = ru.users_id
        LEFT JOIN app.persons ru_p ON ru.person_id = ru_p.persons_id
        LEFT JOIN LATERAL (
            SELECT
                tc.currencies_id AS target_currency_id,
                tc.code AS target_currency_code,
                tc.symbol AS target_currency_symbol,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN 1.0
                    WHEN direct.rate IS NOT NULL THEN direct.rate
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND(1.0 / inv.rate, 8)
                    ELSE NULL
                END AS exchange_rate,
                CASE
                    WHEN p.currency_id = tc.currencies_id THEN (
                        COALESCE(pline.amount, p.amount) - (
                            CASE WHEN p.amount > 0 AND p.discount_amount IS NOT NULL 
                                 THEN ROUND(p.discount_amount * (COALESCE(pline.amount, p.amount) / p.amount), 2)
                                 ELSE 0.00 END
                        )
                    )
                    WHEN direct.rate IS NOT NULL THEN ROUND((
                        COALESCE(pline.amount, p.amount) - (
                            CASE WHEN p.amount > 0 AND p.discount_amount IS NOT NULL 
                                 THEN ROUND(p.discount_amount * (COALESCE(pline.amount, p.amount) / p.amount), 2)
                                 ELSE 0.00 END
                        )
                    ) * direct.rate, tc.decimal_places)
                    WHEN inv.rate IS NOT NULL AND inv.rate > 0 THEN ROUND((
                        COALESCE(pline.amount, p.amount) - (
                            CASE WHEN p.amount > 0 AND p.discount_amount IS NOT NULL 
                                 THEN ROUND(p.discount_amount * (COALESCE(pline.amount, p.amount) / p.amount), 2)
                                 ELSE 0.00 END
                        )
                    ) / inv.rate, tc.decimal_places)
                    ELSE NULL
                END AS converted_amount
            FROM app.currencies tc
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = p.currency_id
                  AND er.quote_currency_id = tc.currencies_id
                  AND er.valid_from <= ((p.payment_date + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) direct ON true
            LEFT JOIN LATERAL (
                SELECT er.rate
                FROM app.exchange_rates er
                WHERE er.base_currency_id = tc.currencies_id
                  AND er.quote_currency_id = p.currency_id
                  AND er.valid_from <= ((p.payment_date + TIME '23:59:59') AT TIME ZONE 'America/Caracas')
                  AND er.is_active = true
                ORDER BY er.valid_from DESC
                LIMIT 1
            ) inv ON true
            WHERE tc.code = UPPER(COALESCE(NULLIF(TRIM($P{P_TARGET_CURRENCY}::varchar), ''), 'USD'))
            LIMIT 1
        ) conv ON true
        WHERE p.is_active = true
          AND ($P{P_DIRECTION}::varchar IS NULL OR $P{P_DIRECTION} = '' OR $P{P_DIRECTION} = 'ALL' OR p.direction = $P{P_DIRECTION}::varchar)
          AND ($P{P_START_DATE}::date IS NULL OR p.payment_date >= $P{P_START_DATE}::date)
          AND ($P{P_END_DATE}::date IS NULL OR p.payment_date <= $P{P_END_DATE}::date)
          AND ($P{P_STATUS}::varchar IS NULL OR $P{P_STATUS} = '' OR $P{P_STATUS} = 'ALL' OR p.status = $P{P_STATUS}::varchar)
          AND ($P{P_PAYMENT_METHOD}::varchar IS NULL OR $P{P_PAYMENT_METHOD} = '' OR $P{P_PAYMENT_METHOD} = 'ALL' OR pm.code = $P{P_PAYMENT_METHOD}::varchar)
        ORDER BY
            p.direction ASC,
            p.payment_date DESC,
            p.payments_id DESC
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="payments_id" class="java.lang.Long"/>
    <field name="direction" class="java.lang.String"/>
    <field name="direction_label" class="java.lang.String"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="payment_method_label" class="java.lang.String"/>
    <field name="reference_number" class="java.lang.String"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="payment_status_label" class="java.lang.String"/>
    <field name="category_name" class="java.lang.String"/>
    <field name="gross_amount" class="java.math.BigDecimal"/>
    <field name="discount_amount" class="java.math.BigDecimal"/>
    <field name="net_amount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="target_currency_code" class="java.lang.String"/>
    <field name="target_currency_symbol" class="java.lang.String"/>
    <field name="converted_amount" class="java.math.BigDecimal"/>
    <field name="exchange_rate" class="java.math.BigDecimal"/>
    <field name="person_name" class="java.lang.String"/>
    <field name="person_document" class="java.lang.String"/>
    <field name="promoter_name" class="java.lang.String"/>
    <field name="plan_name" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="V_DIR_NET" class="java.math.BigDecimal" resetType="Group" resetGroup="DirectionGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{net_amount}]]></variableExpression>
    </variable>
    <variable name="V_DIR_CONVERTED_NET" class="java.math.BigDecimal" resetType="Group" resetGroup="DirectionGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_amount}]]></variableExpression>
    </variable>
    <variable name="V_DIR_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="DirectionGroup" calculation="Count">
        <variableExpression><![CDATA[$F{payments_id}]]></variableExpression>
    </variable>

    <variable name="V_GRAND_NET" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{net_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_CONVERTED_NET" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{converted_amount}]]></variableExpression>
    </variable>
    <variable name="V_GRAND_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{payments_id}]]></variableExpression>
    </variable>

